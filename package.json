{
  "name": "hypixel-guild-discord-bridge",
  "version": "5.2.0",
  "description": "A Hypixel guild chat and Discord chat bridge",
  "type": "module",
  "main": "index.ts",
  "engines": {
    "node": ">=22.16",
    "npm": ">=10.0.0 <12.0.0"
  },
  "scripts": {
    "start": "node --import tsx/esm index.ts",
    "start:prod": "node build/index.js",
    "build": "npx tsc",
    "heroku-postbuild": "echo skipping tsc build - app runs via tsx at runtime",
    "postinstall": "node scripts/prune-minecraft-data.mjs",
    "generate-code": "npx ts-interface-builder src/application-config.ts",
    "generate-docs": "node --import tsx/esm scripts/generate-documentation.ts",
    "lint:fix": "npx eslint . --fix && npx prettier . \"!**/*.ts\" --write",
    "lint:coverage": "npx type-coverage --detail true --update true",
    "test:compile": "npx tsc --noEmit",
    "test:unit": "node --import tsx/esm test/configuration-parser.test.ts",
    "test:run": "node --import tsx/esm index.ts test-run",
    "validate": "npm install && npm run generate-code && npm run generate-docs && npm run lint:fix && npm run test:compile && npm run lint:coverage && npm run test:run"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aidn3/hypixel-guild-discord-bridge.git"
  },
  "keywords": [
    "hypixel",
    "discord",
    "chat",
    "bridge"
  ],
  "author": "aidn5 (development@aidn5.com)",
  "typeCoverage": {
    "atLeast": 99.96
  },
  "dependencies": {
    "axios": "1.19.0",
    "bad-words": "3.0.4",
    "canvas": "3.2.0",
    "chrono-node": "2.9.1",
    "compare-versions": "6.1.1",
    "discord.js": "14.25.1",
    "emittery": "1.2.0",
    "emoji-name-map": "2.0.3",
    "esrever": "0.2.0",
    "hypixel-api-reborn": "11.3.7",
    "i18next": "25.7.3",
    "log4js": "6.9.1",
    "long": "5.3.2",
    "mathjs": "15.2.0",
    "minecraft-data": "3.101.0",
    "minecraft-protocol": "1.66.2",
    "node-cache": "5.1.2",
    "pg": "8.20.0",
    "pg-mem": "3.0.14",
    "prismarine-chat": "1.12.0",
    "prismarine-nbt": "2.7.0",
    "prismarine-registry": "1.11.0",
    "prom-client": "15.1.3",
    "protobufjs": "8.7.1",
    "skyhelper-networth": "2.5.1",
    "socks": "2.8.7",
    "ts-interface-checker": "1.0.2",
    "tsx": "4.21.0",
    "umzug": "3.8.3",
    "ws": "8.21.3",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/esrever": "0.2.3",
    "@types/pg": "8.20.0",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "61.5.0",
    "eslint-plugin-prettier": "5.5.4",
    "eslint-plugin-unicorn": "62.0.0",
    "markdown-table": "^3.0.4",
    "prettier": "3.7.4",
    "ts-interface-builder": "0.3.3",
    "type-coverage": "2.29.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.50.0"
  },
  "overrides": {
    "brace-expansion": "1.1.18",
    "form-data": "4.0.6",
    "immutable": "4.3.9",
    "ip-address": "10.3.1",
    "js-yaml": "4.3.1",
    "undici": "6.28.0",
    "uuid": "11.1.1"
  }
}
