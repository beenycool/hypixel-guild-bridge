{
  "uid": "hypixel-bridge-guild-master",
  "title": "Hypixel Bridge – Guild (master)",
  "tags": ["hypixel", "bridge", "guild", "master"],
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Prometheus",
        "multi": false,
        "name": "DS_PROMETHEUS",
        "options": [],
        "pluginId": "prometheus",
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "type": "query",
        "name": "guild",
        "label": "Guild",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(hypixel_bridge_guild_members, name)",
        "definition": "label_values(hypixel_bridge_guild_members, name)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "type": "query",
        "name": "discord_guild",
        "label": "Discord server",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(hypixel_bridge_discord_role_members, guild_id)",
        "definition": "label_values(hypixel_bridge_discord_role_members, guild_id)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
