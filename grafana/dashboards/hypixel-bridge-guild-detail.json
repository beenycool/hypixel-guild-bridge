{
  "uid": "hypixel-bridge-guild-detail",
  "title": "Hypixel Bridge Guild Detail",
  "tags": ["hypixel", "bridge", "guild"],
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-7d", "to": "now" },
  "refresh": "30s",
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "guild",
        "label": "Guild",
        "query": "label_values(hypixel_bridge_guild_members, name)",
        "datasource": null,
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "current": { "selected": false, "text": "All", "value": ".*" }
      }
    ]
  },
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "afk9lkruxq77kf" },
      "type": "stat",
      "title": "Members",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum(hypixel_bridge_guild_members{name=~\"$guild\"})", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "afk9lkruxq77kf" },
      "type": "stat",
      "title": "Online",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [{ "expr": "sum(hypixel_bridge_guild_members_online{name=~\"$guild\"})", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "afk9lkruxq77kf" },
      "type": "stat",
      "title": "Weekly GEXP",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "targets": [{ "expr": "sum(hypixel_bridge_guild_gexp_weekly{name=~\"$guild\"})", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "afk9lkruxq77kf" },
      "type": "stat",
      "title": "Total GEXP",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "targets": [{ "expr": "sum(hypixel_bridge_guild_gexp_total{name=~\"$guild\"})", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "afk9lkruxq77kf" },
      "type": "timeseries",
      "title": "GEXP Trend",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 4 },
      "targets": [
        { "expr": "hypixel_bridge_guild_gexp_total{name=~\"$guild\"}", "refId": "A" },
        { "expr": "hypixel_bridge_guild_gexp_weekly{name=~\"$guild\"}", "refId": "B" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "afk9lkruxq77kf" },
      "type": "table",
      "title": "Top Members By Weekly GEXP",
      "gridPos": { "h": 10, "w": 8, "x": 0, "y": 12 },
      "targets": [{ "expr": "topk(10, hypixel_bridge_guild_member_gexp_weekly{name=~\"$guild\"})", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "afk9lkruxq77kf" },
      "type": "table",
      "title": "Inactive Members",
      "gridPos": { "h": 10, "w": 8, "x": 8, "y": 12 },
      "targets": [{ "expr": "hypixel_bridge_guild_member_last_seen_at{name=~\"$guild\"}", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "afk9lkruxq77kf" },
      "type": "timeseries",
      "title": "Join and Leave Churn",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 22 },
      "targets": [
        { "expr": "increase(hypixel_bridge_event{event=\"join\"}[30d])", "refId": "A" },
        { "expr": "increase(hypixel_bridge_event{event=\"leave\"}[30d])", "refId": "B" }
      ]
    }
  ]
}
