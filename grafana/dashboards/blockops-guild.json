{
  "uid": "bridge-blockops",
  "title": "blockops - Full Dashboard",
  "tags": ["hypixel", "bridge", "guild", "blockops"],
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "30s",
  "timezone": "browser",
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "datasource": { "type": "prometheus", "uid": "afk9lkruxq77kf" },
      "type": "stat",
      "title": "Total Members",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [{ "expr": "hypixel_bridge_guild_members{name=\"blockops\"}", "refId": "A", "instant": true }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        }
      }
    },
    {
      "id": 2,
      "datasource": { "type": "prometheus", "uid": "afk9lkruxq77kf" },
      "type": "stat",
      "title": "Online Now",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [
        { "expr": "hypixel_bridge_guild_members_online{name=\"blockops\"}", "refId": "A", "instant": true }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        }
      }
    },
    {
      "id": 3,
      "datasource": { "type": "prometheus", "uid": "afk9lkruxq77kf" },
      "type": "stat",
      "title": "Total GEXP",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "targets": [{ "expr": "hypixel_bridge_guild_gexp_total{name=\"blockops\"}", "refId": "A", "instant": true }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "orange", "value": null }] }
        }
      }
    },
    {
      "id": 4,
      "datasource": { "type": "prometheus", "uid": "afk9lkruxq77kf" },
      "type": "stat",
      "title": "Weekly GEXP",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "targets": [{ "expr": "hypixel_bridge_guild_gexp_weekly{name=\"blockops\"}", "refId": "A", "instant": true }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "purple", "value": null }] }
        }
      }
    },
    {
      "id": 5,
      "datasource": { "type": "prometheus", "uid": "afk9lkruxq77kf" },
      "type": "stat",
      "title": "Chat Messages (24h)",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "targets": [
        { "expr": "sum(increase(hypixel_bridge_chat{name=\"blockops\"}[24h]))", "refId": "A", "instant": true }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "yellow", "value": null }] }
        }
      }
    },
    {
      "id": 6,
      "datasource": { "type": "prometheus", "uid": "afk9lkruxq77kf" },
      "type": "stat",
      "title": "Commands Used (24h)",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "targets": [
        { "expr": "sum(increase(hypixel_bridge_command{name=\"blockops\"}[24h]))", "refId": "A", "instant": true }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "cyan", "value": null }] }
        }
      }
    },
    {
      "id": 10,
      "datasource": { "type": "prometheus", "uid": "afk9lkruxq77kf" },
      "type": "row",
      "title": "GEXP Trends",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 4 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 11,
      "datasource": { "type": "prometheus", "uid": "afk9lkruxq77kf" },
      "type": "timeseries",
      "title": "Weekly GEXP Over Time",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "targets": [
        { "expr": "hypixel_bridge_guild_gexp_weekly{name=\"blockops\"}", "refId": "A", "legendFormat": "Weekly GEXP" }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "spanNulls": false, "insertNulls": false },
          "unit": "short"
        }
      }
    },
    {
      "id": 12,
      "datasource": { "type": "prometheus", "uid": "afk9lkruxq77kf" },
      "type": "timeseries",
      "title": "Total GEXP Over Time",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "targets": [
        { "expr": "hypixel_bridge_guild_gexp_total{name=\"blockops\"}", "refId": "A", "legendFormat": "Total GEXP" }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "spanNulls": false, "insertNulls": false },
          "unit": "short"
        }
      }
    },
    {
      "id": 20,
      "datasource": { "type": "prometheus", "uid": "afk9lkruxq77kf" },
      "type": "row",
      "title": "Member Activity",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 21,
      "datasource": { "type": "prometheus", "uid": "afk9lkruxq77kf" },
      "type": "timeseries",
      "title": "Members & Online Trend",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [
        { "expr": "hypixel_bridge_guild_members{name=\"blockops\"}", "refId": "A", "legendFormat": "Total Members" },
        { "expr": "hypixel_bridge_guild_members_online{name=\"blockops\"}", "refId": "B", "legendFormat": "Online" }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "spanNulls": false, "insertNulls": false },
          "unit": "short"
        }
      }
    },
    {
      "id": 22,
      "datasource": { "type": "prometheus", "uid": "afk9lkruxq77kf" },
      "type": "timeseries",
      "title": "Guild Events",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [
        {
          "expr": "increase(hypixel_bridge_event{name=\"blockops\",event=\"join\"}[1h])",
          "refId": "A",
          "legendFormat": "Joins"
        },
        {
          "expr": "increase(hypixel_bridge_event{name=\"blockops\",event=\"leave\"}[1h])",
          "refId": "B",
          "legendFormat": "Leaves"
        },
        {
          "expr": "increase(hypixel_bridge_event{name=\"blockops\",event=\"kick\"}[1h])",
          "refId": "C",
          "legendFormat": "Kicks"
        },
        {
          "expr": "increase(hypixel_bridge_event{name=\"blockops\",event=\"online\"}[1h])",
          "refId": "D",
          "legendFormat": "Online Events"
        },
        {
          "expr": "increase(hypixel_bridge_event{name=\"blockops\",event=\"offline\"}[1h])",
          "refId": "E",
          "legendFormat": "Offline Events"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "spanNulls": false, "insertNulls": false },
          "unit": "short"
        }
      }
    },
    {
      "id": 30,
      "datasource": { "type": "prometheus", "uid": "afk9lkruxq77kf" },
      "type": "row",
      "title": "Chat & Commands",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 31,
      "datasource": { "type": "prometheus", "uid": "afk9lkruxq77kf" },
      "type": "timeseries",
      "title": "Chat by Scope",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "targets": [
        {
          "expr": "increase(hypixel_bridge_chat{name=\"blockops\",scope=\"public\"}[1h])",
          "refId": "A",
          "legendFormat": "Public"
        },
        {
          "expr": "increase(hypixel_bridge_chat{name=\"blockops\",scope=\"officer\"}[1h])",
          "refId": "B",
          "legendFormat": "Officer"
        },
        {
          "expr": "increase(hypixel_bridge_chat{name=\"blockops\",scope=\"discord\"}[1h])",
          "refId": "C",
          "legendFormat": "Discord"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "spanNulls": false, "insertNulls": false },
          "unit": "short"
        }
      }
    },
    {
      "id": 32,
      "datasource": { "type": "prometheus", "uid": "afk9lkruxq77kf" },
      "type": "timeseries",
      "title": "Commands Over Time",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "targets": [
        {
          "expr": "increase(hypixel_bridge_command{name=\"blockops\"}[1h])",
          "refId": "A",
          "legendFormat": "Commands"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "spanNulls": false, "insertNulls": false },
          "unit": "short"
        }
      }
    },
    {
      "id": 40,
      "datasource": { "type": "prometheus", "uid": "afk9lkruxq77kf" },
      "type": "row",
      "title": "Leaderboards",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 41,
      "datasource": { "type": "prometheus", "uid": "afk9lkruxq77kf" },
      "type": "table",
      "title": "Top Members by Weekly GEXP",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 32 },
      "targets": [
        {
          "expr": "topk(25, hypixel_bridge_guild_member_gexp_weekly{name=\"blockops\"})",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": { "member_name": 0, "Value": 1 },
            "renameByName": { "member_name": "Member", "Value": "Weekly GEXP" }
          }
        }
      ],
      "fieldConfig": { "defaults": { "custom": { "align": "auto", "displayMode": "auto" } } }
    },
    {
      "id": 42,
      "datasource": { "type": "prometheus", "uid": "afk9lkruxq77kf" },
      "type": "table",
      "title": "Top Members by Daily GEXP",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 32 },
      "targets": [
        {
          "expr": "topk(25, hypixel_bridge_guild_member_gexp_daily{name=\"blockops\"})",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": { "member_name": 0, "Value": 1 },
            "renameByName": { "member_name": "Member", "Value": "Daily GEXP" }
          }
        }
      ],
      "fieldConfig": { "defaults": { "custom": { "align": "auto", "displayMode": "auto" } } }
    },
    {
      "id": 43,
      "datasource": { "type": "prometheus", "uid": "afk9lkruxq77kf" },
      "type": "table",
      "title": "Currently Online Members",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 42 },
      "targets": [
        {
          "expr": "hypixel_bridge_guild_member_online{name=\"blockops\"} == 1",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": { "member_name": 0, "Value": 1 },
            "renameByName": { "member_name": "Member", "Value": "Online" }
          }
        }
      ],
      "fieldConfig": { "defaults": { "custom": { "align": "auto", "displayMode": "auto" } } }
    },
    {
      "id": 44,
      "datasource": { "type": "prometheus", "uid": "afk9lkruxq77kf" },
      "type": "table",
      "title": "Member Tenure (Join Date)",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 42 },
      "targets": [
        {
          "expr": "hypixel_bridge_guild_member_joined_at{name=\"blockops\"}",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": { "member_name": 0, "Value": 1 },
            "renameByName": { "member_name": "Member", "Value": "Joined At (Unix)" }
          }
        }
      ],
      "fieldConfig": { "defaults": { "custom": { "align": "auto", "displayMode": "auto" } } }
    },
    {
      "id": 50,
      "datasource": { "type": "prometheus", "uid": "afk9lkruxq77kf" },
      "type": "row",
      "title": "Discord",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 52 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 51,
      "datasource": { "type": "prometheus", "uid": "afk9lkruxq77kf" },
      "type": "table",
      "title": "Discord Role Sizes",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 53 },
      "targets": [{ "expr": "hypixel_bridge_discord_role_members", "refId": "A", "format": "table", "instant": true }],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": { "role_name": 0, "Value": 1 },
            "renameByName": { "role_name": "Role", "Value": "Members" }
          }
        }
      ],
      "fieldConfig": { "defaults": { "custom": { "align": "auto", "displayMode": "auto" } } }
    }
  ]
}
