{
  "uid": "master",
  "title": "All Bridges - Master Overview",
  "tags": ["hypixel", "bridge", "master"],
  "schemaVersion": 39,
  "version": 2,
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "30s",
  "timezone": "browser",
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "datasource": { "type": "prometheus", "uid": "afk9lkruxq77kf" },
      "type": "stat",
      "title": "Total Members (All Guilds)",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum(hypixel_bridge_guild_members)", "refId": "A", "instant": true }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        }
      }
    },
    {
      "id": 2,
      "datasource": { "type": "prometheus", "uid": "afk9lkruxq77kf" },
      "type": "stat",
      "title": "Total Online (All Guilds)",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [{ "expr": "sum(hypixel_bridge_guild_members_online)", "refId": "A", "instant": true }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        }
      }
    },
    {
      "id": 3,
      "datasource": { "type": "prometheus", "uid": "afk9lkruxq77kf" },
      "type": "stat",
      "title": "Total GEXP (All Guilds)",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "targets": [{ "expr": "sum(hypixel_bridge_guild_gexp_total)", "refId": "A", "instant": true }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "orange", "value": null }] }
        }
      }
    },
    {
      "id": 4,
      "datasource": { "type": "prometheus", "uid": "afk9lkruxq77kf" },
      "type": "stat",
      "title": "Weekly GEXP (All Guilds)",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "targets": [{ "expr": "sum(hypixel_bridge_guild_gexp_weekly)", "refId": "A", "instant": true }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "purple", "value": null }] }
        }
      }
    },
    {
      "id": 5,
      "datasource": { "type": "prometheus", "uid": "afk9lkruxq77kf" },
      "type": "stat",
      "title": "Total Chat Messages",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "targets": [{ "expr": "sum(increase(hypixel_bridge_chat[24h]))", "refId": "A", "instant": true }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "yellow", "value": null }] }
        }
      }
    },
    {
      "id": 6,
      "datasource": { "type": "prometheus", "uid": "afk9lkruxq77kf" },
      "type": "stat",
      "title": "Total Commands",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "targets": [{ "expr": "sum(increase(hypixel_bridge_command[24h]))", "refId": "A", "instant": true }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "cyan", "value": null }] }
        }
      }
    },
    {
      "id": 10,
      "datasource": { "type": "prometheus", "uid": "afk9lkruxq77kf" },
      "type": "row",
      "title": "Guild Comparison",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 4 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 11,
      "datasource": { "type": "prometheus", "uid": "afk9lkruxq77kf" },
      "type": "timeseries",
      "title": "Members by Guild",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 5 },
      "targets": [
        { "expr": "hypixel_bridge_guild_members", "refId": "A", "legendFormat": "{{name}} - Total" },
        { "expr": "hypixel_bridge_guild_members_online", "refId": "B", "legendFormat": "{{name}} - Online" }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "spanNulls": false, "insertNulls": false },
          "unit": "short"
        }
      }
    },
    {
      "id": 12,
      "datasource": { "type": "prometheus", "uid": "afk9lkruxq77kf" },
      "type": "timeseries",
      "title": "Weekly GEXP by Guild",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 5 },
      "targets": [{ "expr": "hypixel_bridge_guild_gexp_weekly", "refId": "A", "legendFormat": "{{name}}" }],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "spanNulls": false, "insertNulls": false },
          "unit": "short"
        }
      }
    },
    {
      "id": 13,
      "datasource": { "type": "prometheus", "uid": "afk9lkruxq77kf" },
      "type": "timeseries",
      "title": "Total GEXP by Guild",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 5 },
      "targets": [{ "expr": "hypixel_bridge_guild_gexp_total", "refId": "A", "legendFormat": "{{name}}" }],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "spanNulls": false, "insertNulls": false },
          "unit": "short"
        }
      }
    },
    {
      "id": 20,
      "datasource": { "type": "prometheus", "uid": "afk9lkruxq77kf" },
      "type": "row",
      "title": "Activity & Events",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 21,
      "datasource": { "type": "prometheus", "uid": "afk9lkruxq77kf" },
      "type": "timeseries",
      "title": "Guild Events (Join/Leave/Kick)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [
        {
          "expr": "sum by (event) (increase(hypixel_bridge_event{event=\"join\"}[1h]))",
          "refId": "A",
          "legendFormat": "Joins"
        },
        {
          "expr": "sum by (event) (increase(hypixel_bridge_event{event=\"leave\"}[1h]))",
          "refId": "B",
          "legendFormat": "Leaves"
        },
        {
          "expr": "sum by (event) (increase(hypixel_bridge_event{event=\"kick\"}[1h]))",
          "refId": "C",
          "legendFormat": "Kicks"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "spanNulls": false, "insertNulls": false },
          "unit": "short"
        }
      }
    },
    {
      "id": 22,
      "datasource": { "type": "prometheus", "uid": "afk9lkruxq77kf" },
      "type": "timeseries",
      "title": "Chat Activity by Scope",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [
        { "expr": "sum by (scope) (increase(hypixel_bridge_chat[1h]))", "refId": "A", "legendFormat": "{{scope}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "spanNulls": false, "insertNulls": false },
          "unit": "short"
        }
      }
    },
    {
      "id": 30,
      "datasource": { "type": "prometheus", "uid": "afk9lkruxq77kf" },
      "type": "row",
      "title": "Top Performers",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 31,
      "datasource": { "type": "prometheus", "uid": "afk9lkruxq77kf" },
      "type": "table",
      "title": "Top Members by Weekly GEXP",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "targets": [
        {
          "expr": "topk(20, hypixel_bridge_guild_member_gexp_weekly)",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": { "member_name": 0, "name": 1, "Value": 2 },
            "renameByName": { "member_name": "Member", "name": "Guild", "Value": "Weekly GEXP" }
          }
        }
      ]
    },
    {
      "id": 32,
      "datasource": { "type": "prometheus", "uid": "afk9lkruxq77kf" },
      "type": "table",
      "title": "Discord Role Sizes",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "targets": [
        { "expr": "topk(20, hypixel_bridge_discord_role_members)", "refId": "A", "format": "table", "instant": true }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": { "role_name": 0, "Value": 1 },
            "renameByName": { "role_name": "Role", "Value": "Members" }
          }
        }
      ]
    }
  ]
}
