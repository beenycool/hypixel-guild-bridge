{
  "uid": "hypixel-bridge-overview",
  "title": "Hypixel Bridge Overview",
  "tags": ["hypixel", "bridge", "prometheus"],
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "30s",
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Prometheus",
        "multi": false,
        "name": "DS_PROMETHEUS",
        "options": [],
        "pluginId": "prometheus",
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      }
    ]
  },
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "type": "stat",
      "title": "Total Members",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum(hypixel_bridge_guild_members)", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto" }
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "type": "stat",
      "title": "Total Online",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [{ "expr": "sum(hypixel_bridge_guild_members_online)", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto" }
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "type": "stat",
      "title": "Total GEXP",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "targets": [{ "expr": "sum(hypixel_bridge_guild_gexp_total)", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto" }
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "type": "stat",
      "title": "Weekly GEXP",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "targets": [{ "expr": "sum(hypixel_bridge_guild_gexp_weekly)", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto" }
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "type": "timeseries",
      "title": "Guild Members and Online Trend",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 4 },
      "targets": [
        { "expr": "sum(hypixel_bridge_guild_members)", "refId": "A" },
        { "expr": "sum(hypixel_bridge_guild_members_online)", "refId": "B" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "type": "timeseries",
      "title": "Guild GEXP Trend",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 4 },
      "targets": [
        { "expr": "sum by (name) (hypixel_bridge_guild_gexp_total)", "refId": "A" },
        { "expr": "sum by (name) (hypixel_bridge_guild_gexp_weekly)", "refId": "B" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "type": "table",
      "title": "Top Guilds By Weekly GEXP",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 12 },
      "targets": [{ "expr": "topk(10, sum by (name) (hypixel_bridge_guild_gexp_weekly))", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "type": "table",
      "title": "Discord Role Sizes",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 12 },
      "targets": [{ "expr": "topk(20, hypixel_bridge_discord_role_members)", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "type": "timeseries",
      "title": "Guild Event Churn",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 20 },
      "targets": [
        { "expr": "increase(hypixel_bridge_event{event=\"join\"}[7d])", "refId": "A" },
        { "expr": "increase(hypixel_bridge_event{event=\"leave\"}[7d])", "refId": "B" },
        { "expr": "increase(hypixel_bridge_event{event=\"kick\"}[7d])", "refId": "C" }
      ]
    }
  ]
}
